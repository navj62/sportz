# Copy to .env and fill in. Only the two REQUIRED keys are needed to boot;
# everything below them has a working default or degrades gracefully.
#
#   cp .env.example .env

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. From the Neon Console -> Project -> Dashboard ->
# Connect. Include ?sslmode=require. The app exits on the first query without it.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# API-Football key, from dashboard.api-football.com -> Profile. The free tier
# allows 100 requests/day, which the sync intervals below are sized against.
# Throws on first use if unset.
API_FOOTBALL_KEY=your-api-football-key

# ─── Optional — HTTP server ──────────────────────────────────────────────────

# Port to listen on. Default: 8000
PORT=8000

# Interface to bind. Unset listens on all interfaces, which is what you want in
# Docker. Set 0.0.0.0 explicitly for containers that need it named.
HOST=0.0.0.0

# pino level: trace | debug | info | warn | error | fatal | silent. Default: info
LOG_LEVEL=info

# ─── Optional — Arcjet (bot detection, rate limiting, shield) ────────────────

# From app.arcjet.com -> your site -> SDK Key. When unset, Arcjet is skipped
# entirely and every request passes through unprotected — fine locally, not in
# production.
ARCJET_KEY=ajkey_your_arcjet_key

# Set to 'development' to run rules in DRY_RUN (logged, never blocked). Any
# other value, including unset, runs them in LIVE mode and blocks.
ARCJET_ENV=development

# ─── Optional — Upstash Redis (upstream cache, locks, endpoint cache) ────────

# Both must be set for Redis to activate. From console.upstash.com -> your
# database -> REST API. When either is missing the app runs identically with
# caching and locking as no-ops, so leaving these blank is a supported setup.
UPSTASH_REDIS_REST_URL=https://your-database-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── Optional — sync tuning ──────────────────────────────────────────────────
# Defaults are sized against the API-Football free tier (100 requests/day). One
# request per live cycle at 15 min is ~96/day. The idle interval must stay
# LONGER than the live one, or idling costs more quota than being live.

# How often to poll while matches are live (ms). Default: 900000 (15 min)
LIVE_SYNC_INTERVAL_MS=900000

# How often to poll while nothing is live (ms). Default: 1800000 (30 min)
LIVE_SYNC_IDLE_INTERVAL_MS=1800000

# How often to refresh league standings (ms). Default: 3600000 (1 hour)
STANDINGS_SYNC_INTERVAL_MS=3600000

# Standings sync is OFF unless this is exactly the string 'true'. It costs one
# request per competition per cycle, which exhausts the free tier quickly.
STANDINGS_SYNC_ENABLED=false

# ─── Optional — tests ────────────────────────────────────────────────────────

# A SEPARATE database from DATABASE_URL. The integration suite TRUNCATEs every
# table it touches, and tests/setup.js redirects DATABASE_URL to this value so a
# misconfigured run cannot wipe production. Unset skips the integration suite.
TEST_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname_test?sslmode=require
