# Copy to .env and fill in. Only the two REQUIRED keys are needed to boot;
# everything below them has a working default or degrades gracefully.
#
#   cp .env.example .env

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. From the Neon Console -> Project -> Dashboard ->
# Connect. Include ?sslmode=require. The app exits on the first query without it.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# API-Football key, from dashboard.api-football.com -> Profile. The free tier
# allows 100 requests/day, which the sync intervals below are sized against.
# Throws on first use if unset.
API_FOOTBALL_KEY=your-api-football-key

# ─── Optional — HTTP server ──────────────────────────────────────────────────

# Port to listen on. Default: 8000
PORT=8000

# Interface to bind. Unset listens on all interfaces, which is what you want in
# Docker. Set 0.0.0.0 explicitly for containers that need it named.
HOST=0.0.0.0

# pino level: trace | debug | info | warn | error | fatal | silent. Default: info
LOG_LEVEL=info

# ─── Optional — Arcjet (bot detection, rate limiting, shield) ────────────────

# From app.arcjet.com -> your site -> SDK Key. When unset, Arcjet is skipped
# entirely and every request passes through unprotected — fine locally, not in
# production.
ARCJET_KEY=ajkey_your_arcjet_key

# Set to 'development' to run rules in DRY_RUN (logged, never blocked). Any
# other value, including unset, runs them in LIVE mode and blocks.
ARCJET_ENV=development

# ─── Optional — Upstash Redis (upstream cache, locks, endpoint cache) ────────

# Both must be set for Redis to activate. From console.upstash.com -> your
# database -> REST API. When either is missing the app runs identically with
# caching and locking as no-ops, so leaving these blank is a supported setup.
UPSTASH_REDIS_REST_URL=https://your-database-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# A SECOND, SEPARATE Upstash database, used only by the test suite. tests/setup.js
# redirects the two vars above to these before any module loads, exactly as it
# redirects DATABASE_URL to TEST_DATABASE_URL.
#
# This must be a different database, not the same one with a different name. The
# cache key encodes the query parameters and nothing about which database
# answered, so the deployed backend and the suite otherwise collide on the very
# same key — and the competitions TTL of 3600s means one production request can
# fail the suite for the next hour.
#
# The two real-Redis suites (redis.test.js, cachedReads.test.js — 33 tests) gate
# on TEST_UPSTASH_REDIS_REST_URL, so leaving these blank SKIPS them rather than running
# them against the production instance. The run prints a warning when it does.
TEST_UPSTASH_REDIS_REST_URL=https://your-test-database-67890.upstash.io
TEST_UPSTASH_REDIS_REST_TOKEN=your-test-upstash-rest-token

# ─── Optional — sync tuning ──────────────────────────────────────────────────
# Defaults are sized against the API-Football free tier (100 requests/day). One
# request per live cycle at 20 min is 72/day, plus up to 24 reconciliation
# sweeps and one boot /status = 97 of 100. The idle interval must stay LONGER
# than the live one, or idling costs more quota than being live.

# How often to poll while matches are live (ms). Default: 1200000 (20 min)
LIVE_SYNC_INTERVAL_MS=1200000

# How often to poll while nothing is live (ms). Default: 1800000 (30 min)
LIVE_SYNC_IDLE_INTERVAL_MS=1800000

# How often to refresh league standings (ms). Default: 3600000 (1 hour)
STANDINGS_SYNC_INTERVAL_MS=3600000

# Standings sync is OFF unless this is exactly the string 'true'. It costs one
# request per competition per cycle, which exhausts the free tier quickly.
STANDINGS_SYNC_ENABLED=false

# Reconciliation tier 2, the date-sweep confirm that recovers real final scores
# for matches that left the live feed. Ships ENABLED — this is opt-OUT, unlike
# STANDINGS_SYNC_ENABLED above, so ONLY the exact string 'false' disables it and
# anything else (including unset) leaves it on. Budgeted at up to 24 sweeps/day
# in the figures above; turning it off frees that quota but leaves departed
# matches carrying whatever score was last polled, possibly from the 60th
# minute. Tier 1, the time floor, is unconditional and not affected by this.
RECONCILE_CONFIRM_ENABLED=true

# ─── Optional — debug endpoints ──────────────────────────────────────────────

# Exposes GET /debug/stats when set to exactly the string 'true'. Default off.
# It reports cache hit/miss health (including a status that says outright when
# the cache is enabled but never hitting), poll-lock outcome counters, and
# Redis reachability.
#
# This API has no auth, so anything enabled here is public. The endpoint sits
# behind the rate limiter and bot detection, unlike /health, but that is a
# throttle rather than a lock. Turn it on to diagnose, then turn it off.
DEBUG_ENDPOINTS_ENABLED=false

# ─── Optional — tests ────────────────────────────────────────────────────────

# A SEPARATE database from DATABASE_URL. The integration suite TRUNCATEs every
# table it touches, and tests/setup.js redirects DATABASE_URL to this value so a
# misconfigured run cannot wipe production. Unset skips the integration suite.
TEST_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname_test?sslmode=require
